{
  "name": "tablecloth",
  "displayName": "Tablecloth",
  "description": "IntelliJ-grade database tools, laid over VS Code. PostgreSQL, MySQL/MariaDB, and SQLite: explorer tree, query consoles, and a DataGrip-style data grid.",
  "version": "0.0.3",
  "publisher": "sultanofcardio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sultanofcardio/tablecloth.git"
  },
  "homepage": "https://github.com/sultanofcardio/tablecloth#readme",
  "bugs": {
    "url": "https://github.com/sultanofcardio/tablecloth/issues"
  },
  "preview": true,
  "pricing": "Free",
  "galleryBanner": {
    "color": "#2b3a55",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, Project (workspace) data sources are hidden and cannot be created; Global data sources, consoles, and the grid work as usual.",
      "restrictedConfigurations": [
        "tablecloth.dataSources"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "SQLite database files, SSH private keys, and CA certificates must live on the local file system. Running .sql files from a virtual workspace works."
    }
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "database",
    "sql",
    "postgresql",
    "mysql",
    "mariadb",
    "sqlite"
  ],
  "icon": "assets/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:sql"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tablecloth",
          "title": "Database",
          "icon": "assets/activity-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "tableclothPanel",
          "title": "Tablecloth",
          "icon": "assets/activity-icon.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "tablecloth.console",
        "displayName": "Tablecloth Console",
        "selector": [
          {
            "filenamePattern": "**/sultanofcardio.tablecloth/consoles/**/*.sql"
          }
        ],
        "priority": "default"
      }
    ],
    "views": {
      "tablecloth": [
        {
          "id": "tablecloth.explorer",
          "type": "webview",
          "name": "Database",
          "contextualTitle": "Database"
        }
      ],
      "tableclothPanel": [
        {
          "id": "tablecloth.services",
          "type": "webview",
          "name": "Tablecloth",
          "contextualTitle": "Tablecloth"
        }
      ]
    },
    "commands": [
      {
        "command": "tablecloth.addDataSource",
        "title": "New Data Source…",
        "category": "Tablecloth",
        "icon": "$(add)"
      },
      {
        "command": "tablecloth.editDataSource",
        "title": "Data Source Properties…",
        "category": "Tablecloth",
        "icon": "$(settings-gear)"
      },
      {
        "command": "tablecloth.duplicateDataSource",
        "title": "Duplicate Data Source",
        "category": "Tablecloth"
      },
      {
        "command": "tablecloth.removeDataSource",
        "title": "Remove Data Source…",
        "category": "Tablecloth"
      },
      {
        "command": "tablecloth.refreshNode",
        "title": "Refresh",
        "category": "Tablecloth",
        "icon": "$(refresh)"
      },
      {
        "command": "tablecloth.disconnect",
        "title": "Disconnect",
        "category": "Tablecloth"
      },
      {
        "command": "tablecloth.newConsole",
        "title": "Query Console…",
        "category": "Tablecloth",
        "icon": "$(terminal)"
      },
      {
        "command": "tablecloth.runStatement",
        "title": "Run Statement",
        "category": "Tablecloth",
        "icon": "$(play)"
      },
      {
        "command": "tablecloth.runFile",
        "title": "Run File on Bound Data Source",
        "category": "Tablecloth"
      },
      {
        "command": "tablecloth.runFileOnDataSource",
        "title": "Run File on Data Source…",
        "category": "Tablecloth"
      },
      {
        "command": "tablecloth.attachFile",
        "title": "Attach File to Data Source…",
        "category": "Tablecloth",
        "icon": "$(plug)"
      },
      {
        "command": "tablecloth.queryHistory",
        "title": "Query History",
        "category": "Tablecloth",
        "icon": "$(history)"
      },
      {
        "command": "tablecloth.txMode",
        "title": "Transaction Mode…",
        "category": "Tablecloth",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "tablecloth.commit",
        "title": "Commit Transaction",
        "category": "Tablecloth",
        "icon": "$(check)"
      },
      {
        "command": "tablecloth.rollback",
        "title": "Roll Back Transaction",
        "category": "Tablecloth",
        "icon": "$(discard)"
      },
      {
        "command": "tablecloth.selectSchema",
        "title": "Select Schema…",
        "category": "Tablecloth",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "tablecloth.toggleSystemSchemas",
        "title": "Show/Hide System Schemas",
        "category": "Tablecloth",
        "icon": "$(eye)"
      },
      {
        "command": "tablecloth.cancelStatement",
        "title": "Cancel Running Statement",
        "category": "Tablecloth",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tablecloth.formatSql",
        "title": "Format SQL",
        "category": "Tablecloth"
      },
      {
        "command": "tablecloth.gotoObject",
        "title": "Go to Database Object…",
        "category": "Tablecloth",
        "icon": "$(search)"
      },
      {
        "command": "tablecloth.importData",
        "title": "Import Data from File…",
        "category": "Tablecloth",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "tablecloth.runStatement",
          "when": "editorLangId == sql",
          "group": "navigation@1"
        },
        {
          "command": "tablecloth.queryHistory",
          "when": "editorLangId == sql",
          "group": "navigation@2"
        },
        {
          "command": "tablecloth.txMode",
          "when": "editorLangId == sql && tablecloth.consoleBound",
          "group": "navigation@3"
        },
        {
          "command": "tablecloth.commit",
          "when": "editorLangId == sql && tablecloth.txManual",
          "group": "navigation@4"
        },
        {
          "command": "tablecloth.rollback",
          "when": "editorLangId == sql && tablecloth.txManual",
          "group": "navigation@5"
        }
      ],
      "editor/context": [
        {
          "command": "tablecloth.runStatement",
          "when": "editorLangId == sql",
          "group": "tablecloth@1"
        },
        {
          "command": "tablecloth.runFile",
          "when": "editorLangId == sql",
          "group": "tablecloth@2"
        },
        {
          "command": "tablecloth.attachFile",
          "when": "editorLangId == sql",
          "group": "tablecloth@3"
        }
      ],
      "explorer/context": [
        {
          "command": "tablecloth.runFileOnDataSource",
          "when": "resourceExtname == .sql",
          "group": "tablecloth@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tablecloth.runStatement",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "tablecloth.formatSql",
        "key": "ctrl+alt+l",
        "mac": "cmd+alt+l",
        "when": "editorTextFocus && editorLangId == sql"
      },
      {
        "command": "tablecloth.cancelStatement",
        "key": "ctrl+f2",
        "mac": "cmd+f2",
        "when": "activeCustomEditorId == tablecloth.console || (editorLangId == sql && tablecloth.consoleBound)"
      },
      {
        "command": "tablecloth.gotoObject",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "focusedView == tablecloth.explorer || focusedView == tablecloth.services || activeCustomEditorId == tablecloth.console || activeWebviewPanelId == tablecloth.table"
      }
    ],
    "configuration": {
      "title": "Tablecloth",
      "properties": {
        "tablecloth.dataSources": {
          "type": "array",
          "default": [],
          "scope": "window",
          "markdownDescription": "Data source definitions, managed through the **Tablecloth: New Data Source** dialog. Entries in user settings are Global data sources; entries in workspace settings are Project data sources. Passwords are kept in the VS Code secret store, never in this setting.",
          "items": {
            "type": "object"
          }
        },
        "tablecloth.dialogs.openIn": {
          "type": "string",
          "enum": [
            "floatingWindow",
            "editorTab"
          ],
          "enumDescriptions": [
            "Open in a separate compact window. Closest to the JetBrains behaviour.",
            "Open as a tab in the main window."
          ],
          "default": "floatingWindow",
          "markdownDescription": "Where Tablecloth shows its dialogs (Data Sources, Import Data). Separate windows open compact, stripped back to their content. Falls back to an editor tab when the editor build cannot open a separate window."
        },
        "tablecloth.dataSourceDialog.openIn": {
          "type": "string",
          "enum": [
            "floatingWindow",
            "editorTab"
          ],
          "default": "floatingWindow",
          "markdownDeprecationMessage": "Replaced by `#tablecloth.dialogs.openIn#`, which covers every Tablecloth dialog. Still honored when the new setting is unset."
        },
        "tablecloth.inspections.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Flag unresolved tables and columns in consoles and attached SQL files, with Change-to quick fixes."
        },
        "tablecloth.grid.pageSize": {
          "type": "number",
          "default": 500,
          "minimum": 1,
          "description": "Default number of rows per data grid page."
        },
        "tablecloth.explorer.showSystemSchemas": {
          "type": "boolean",
          "default": false,
          "description": "Show system schemas and databases (pg_catalog, information_schema, mysql, sys, …) in the explorer tree."
        },
        "tablecloth.export.nullText": {
          "type": "string",
          "default": "",
          "description": "Text used for NULL values in CSV-family exports."
        },
        "tablecloth.export.csvQuoteAll": {
          "type": "boolean",
          "default": false,
          "description": "Quote every value in CSV-family exports, not just the ones that need it."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "npm run pretest && node --test \"out-test/test/*.test.js\"",
    "test:integration": "npm run pretest && node --test \"out-test/test/integration/*.test.js\"",
    "test:vscode": "npm run build && node test/vscode/runTest.mjs",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "mysql2": "^3.15.0",
    "node-sqlite3-wasm": "^0.8.45",
    "pg": "^8.16.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@types/ssh2": "^1.15.0",
    "@types/vscode": "~1.95.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "dompurify": "^3.4.14",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "monaco-editor": "^0.56.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0"
  },
  "overrides": {
    "dompurify": "^3.4.14"
  }
}
